# ShelfIQ v3.0 — Local Development Environment
# Copy this to .env and fill in real values for production

ENVIRONMENT=development
DEBUG=true

# Database (SQLite for dev)
# DATABASE_URL=sqlite+aiosqlite:///./database/retail_shelf.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/shelfiq

# Redis (optional for dev — falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# JWT (use stronger secrets in production)
JWT_SECRET_KEY=shelfiq-dev-secret-change-in-production-please
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# WhatsApp Business API (leave empty to skip WhatsApp in dev)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=shelfiq-webhook-verify-dev
WHATSAPP_WEBHOOK_SECRET=

# Razorpay (leave empty to skip billing in dev)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Field Encryption (32 hex chars = 16 bytes for dev; use 64 hex chars = 32 bytes for AES-256 in prod)
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501

# Sentry (optional)
SENTRY_DSN=
