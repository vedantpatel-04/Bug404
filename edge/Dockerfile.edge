# ShelfIQ Edge AI — Dockerfile for Raspberry Pi 5 / Jetson Nano
# Packages YOLOv8n + alert logic for offline inference
# Syncs results to cloud when connectivity returns

FROM python:3.11-slim

WORKDIR /app

# System deps for OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

# Minimal dependencies for edge inference
RUN pip install --no-cache-dir \
    numpy>=1.24.0 \
    opencv-python-headless>=4.8.0 \
    ultralytics>=8.0.0 \
    httpx>=0.27.0 \
    pydantic>=2.0.0 \
    schedule>=1.2.0

# Copy only the modules needed for edge inference
COPY models/ ./models/
COPY config/settings.py ./config/settings.py
COPY config/__init__.py ./config/__init__.py
COPY alerts/alert_models.py ./alerts/alert_models.py
COPY alerts/__init__.py ./alerts/__init__.py
COPY pipeline/shelf_analysis_pipeline.py ./pipeline/shelf_analysis_pipeline.py
COPY pipeline/__init__.py ./pipeline/__init__.py
COPY edge/sync_daemon.py ./sync_daemon.py

# YOLOv8 nano weights (smallest model for edge)
COPY yolov8n.pt ./yolov8n.pt

ENV YOLO_MODEL=yolov8n.pt
ENV SHELFIQ_CLOUD_URL=https://api.shelfiq.in
ENV SYNC_INTERVAL_SECONDS=300

CMD ["python", "sync_daemon.py"]
